+    def _reserve_num_per_rank(self, reserve_cpu_num: int) -> list[int]:
+        """Split reserve_cpu_num across local ranks, last rank first."""
+        reserve_num_per_rank = [
+            reserve_cpu_num // self.local_world_size
+        ] * self.local_world_size
+        for i in range(
+            self.local_world_size - 1,
+            self.local_world_size - 1 - reserve_cpu_num % self.local_world_size,
+            -1,
+        ):
+            reserve_num_per_rank[i] += 1
+        return reserve_num_per_rank
