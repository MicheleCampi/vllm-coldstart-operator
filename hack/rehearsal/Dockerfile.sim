# Rehearsal image for item-4 kind validation: llm-d inference sim with the
# serving args baked into the entrypoint. Needed because the operator's
# gpu=0 placeholder path deliberately injects no command/args — the image
# must be self-configuring. Latencies are those of one L4 serving
# Qwen2.5-7B-Instruct in bf16 on vLLM v0.11.0 (B-005, ADR-0024), so a
# drain finds streams in flight as long as the GPU's.
# max-model-len is an admission limit, not a latency input: 16384 admits
# every request of the Azure trace profile in hack/loadgen/profiles.
FROM ghcr.io/llm-d/llm-d-inference-sim:v0.8.2@sha256:c3ba435081a4d032676b218ea34eb3a1c54507da0fade2f6297f9c37894fe0d1
ENTRYPOINT ["/app/llm-d-inference-sim", \
  "--model", "facebook/opt-125m", \
  "--port", "8000", \
  "--prefill-overhead", "135ms", \
  "--prefill-time-per-token", "226us", \
  "--inter-token-latency", "66ms", \
  "--max-num-seqs", "256", \
  "--time-factor-under-load", "7.79", \
  "--max-model-len", "16384"]
