# ADR-0009 D5 image: the rehearsal simulator behind an artificial warm-up
# delay. The simulator has no warm-up flag (checked at --help on v0.8.2;
# see the 2026-08-01 postscript on ADR-0009), and the operator hardcodes
# the readiness probe's initialDelaySeconds, so the only reachable lever
# is the health endpoint: sleep before serving, the pod stays not-Ready,
# and the placement stays Pending/Warming — the state D3 publishes.
# The FleetService template exposes no env field (image, gpu, healthPath,
# extraArgs, modelCacheHostPath, runtimeClassName only), so the value is
# baked at build time via --build-arg rather than set per deployment.
# Both D5 arms share one warm-up window, so one tag serves both.
# exec so the simulator is PID 1 and receives SIGTERM: the D5 scale-down
# assertion depends on surplus children actually terminating.
FROM ghcr.io/llm-d/llm-d-inference-sim:v0.8.2
ARG WARMUP_DELAY_S=0
ENV WARMUP_DELAY_S=${WARMUP_DELAY_S}
ENTRYPOINT ["sh", "-c", "sleep ${WARMUP_DELAY_S:-0} && exec /app/llm-d-inference-sim \
  --model facebook/opt-125m \
  --port 8000 \
  --time-to-first-token 250ms \
  --inter-token-latency 20ms \
  --time-factor-under-load 2.0 \
  --max-model-len 4096"]
