{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Every pinned version gets an update PR; nothing is released until a maintainer merges and tags. hack/gpu-session, hack/adr*, docs/ and recorded runs keep the versions they ran on.",
  "extends": [
    "config:best-practices",
    ":timezone(Europe/Rome)",
    "schedule:weekly"
  ],
  "ignorePresets": [":ignoreModulesAndTests"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 6,
  "ignorePaths": ["docs/**", "hack/gpu-session/**", "hack/adr*/**", "**/runs/**"],
  "kubernetes": {
    "managerFilePatterns": ["/^deploy/examples/.+\\.ya?ml$/", "/^hack/scale-out/.+\\.ya?ml$/"]
  },
  "lockFileMaintenance": {"enabled": true, "schedule": ["* 0-6 1-7 * 1"]},
  "customManagers": [
    {
      "customType": "regex",
      "description": "Rust toolchain channel (rust-toolchain.toml); the Dockerfile image and the dtolnay action move with it",
      "managerFilePatterns": ["/^rust-toolchain\\.toml$/"],
      "matchStrings": ["channel = \"(?<currentValue>\\d+\\.\\d+)\""],
      "datasourceTemplate": "docker",
      "depNameTemplate": "mirror.gcr.io/library/rust",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "kind and its node image in CI",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "KIND_VERSION: (?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "KIND_NODE_IMAGE: (?<depName>kindest/node):(?<currentValue>v[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "matchStringsStrategy": "any",
      "datasourceTemplate": "{{#if depName}}docker{{else}}github-releases{{/if}}",
      "depNameTemplate": "{{#if depName}}{{depName}}{{else}}kubernetes-sigs/kind{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Images pinned by tag and digest in workflow env (vLLM CPU)",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["_IMAGE: (?<depName>[^:@\\s]+/[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Rust toolchain: one PR for rust-toolchain.toml, the builder image and the CI action",
      "matchPackageNames": ["mirror.gcr.io/library/rust", "rust", "dtolnay/rust-toolchain"],
      "groupName": "Rust toolchain"
    },
    {
      "description": "kind: the binary and the node image together",
      "matchPackageNames": ["kubernetes-sigs/kind", "kindest/node"],
      "groupName": "kind"
    },
    {
      "description": "vLLM: a new engine version invalidates latency numbers; re-measure before citing them",
      "matchPackageNames": ["docker.io/vllm/vllm-openai-cpu", "vllm/vllm-openai-cpu", "vllm/vllm-openai"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?<compatibility>-x86_64)?$",
      "groupName": "vLLM image",
      "prBodyNotes": ["The `first request after Ready on vLLM CPU` job is the test. Every latency number in README, CHANGELOG and ADRs states the vLLM version it was measured on: say which still hold."]
    },
    {
      "description": "kube and k8s-openapi move together (the k8s-openapi feature names the Kubernetes version)",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["kube", "k8s-openapi"],
      "groupName": "kube-rs"
    },
    {
      "description": "Majors wait for an explicit go on the dependency dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
